<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>co.edu.corhuila.dlc</groupId>
        <artifactId>dlc-appointments-api</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>appointments-core</artifactId>

    <name>appointments-core</name>

    <dependencies>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>

                <executions>
                    <execution>
                        <id>enforce-core-boundary</id>
                        <phase>validate</phase>

                        <goals>
                            <goal>enforce</goal>
                        </goals>

                        <configuration>
                            <rules>

                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>

                                    <excludes>
                                        <exclude>org.springframework:*</exclude>
                                        <exclude>org.springframework.boot:*</exclude>
                                        <exclude>org.springframework.data:*</exclude>
                                        <exclude>org.springframework.security:*</exclude>
                                        <exclude>org.springframework.amqp:*</exclude>
                                        <exclude>org.springframework.integration:*</exclude>

                                        <exclude>jakarta.persistence:*</exclude>

                                        <exclude>org.hibernate:*</exclude>
                                        <exclude>org.hibernate.orm:*</exclude>

                                        <exclude>org.postgresql:postgresql</exclude>

                                        <exclude>com.rabbitmq:amqp-client</exclude>
                                    </excludes>

                                    <message>
                                        appointments-core must remain independent from Spring,
                                        JPA, persistence, messaging, and infrastructure frameworks.
                                    </message>
                                </bannedDependencies>

                            </rules>

                            <fail>true</fail>
                        </configuration>

                    </execution>
                </executions>

            </plugin>

        </plugins>
    </build>

</project>