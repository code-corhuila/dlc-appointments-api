# Application
SERVER_PORT=8080

# PostgreSQL - local development only
POSTGRES_DB=appointments
POSTGRES_USER=<appointments_db_user>
POSTGRES_PASSWORD=<appointments_db_password>
POSTGRES_PORT=5432

# RabbitMQ - local development only
RABBITMQ_DEFAULT_USER=<rabbitmq_user>
RABBITMQ_DEFAULT_PASS=<rabbitmq_password>
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Integration tests
# Leave empty when a real PostgreSQL test database is not available.
TEST_DATABASE_URL=