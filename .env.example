# Application
SERVER_PORT=8080

# Staff access tokens (Norma 5.3.7) - public key only, never a private key
# Single-line PEM with literal \n, or a mounted file
JWT_PUBLIC_KEY=<single-line-public-key-pem>
# JWT_PUBLIC_KEY_FILE=/run/secrets/auth-public-key.pem
JWT_ISSUER=<auth-issuer>
JWT_AUDIENCE=<staff-token-audience>

# Auth session validation (private /internal/v1 route)
# Service JWTs accepted on /internal/v1 (Clinical, worker): never the staff key.
INTERNAL_SERVICE_JWT_PUBLIC_KEY=<single-line-service-public-key-pem>
# INTERNAL_SERVICE_JWT_PUBLIC_KEY_FILE=/run/secrets/service-public-key.pem
INTERNAL_SERVICE_JWT_ISSUER=<service-token-issuer>
INTERNAL_SERVICE_JWT_AUDIENCE=<appointments-service-audience>

# Outbox relay to RabbitMQ (exchange appointments.events). The URI carries the broker credentials: keep it secret.
APPOINTMENTS_RABBITMQ_URI=amqp://<user>:<password>@dlc-rabbitmq:5672
# APPOINTMENTS_RELAY_ENABLED=true
# Consumers of clinical.events (ClinicalCareCompleted) and patients.events (PatientDeactivated), same URI.
# APPOINTMENTS_CONSUMERS_ENABLED=true
# APPOINTMENTS_CONSUMER_ATTEMPTS=5
# APPOINTMENTS_CONSUMER_BACKOFF=PT1S

AUTH_INTERNAL_URL=<auth-internal-origin>
AUTH_SERVICE_TOKEN_FILE=/run/secrets/appointments-to-auth
# AUTH_SERVICE_TOKEN=

# Patients active-state validation (private /internal/v1 route)
PATIENTS_INTERNAL_URL=<patients-internal-origin>
PATIENTS_SERVICE_TOKEN_FILE=/run/secrets/appointments-to-patients
# PATIENTS_SERVICE_TOKEN=

# Appointments schema as the runtime role (never the migrator); the API runs no migrations
DB_URL=jdbc:postgresql://<postgres-host>:5432/<database>
DB_USERNAME=<appointments-runtime-login>
DB_PASSWORD=<appointments-runtime-password>

# Docker Compose (deploy/compose.yml): external network and the host folder mounted read-only at /run/secrets
# PLATFORM_NETWORK=platform
APPOINTMENTS_SECRETS_DIR=<host-folder-with-service-tokens-and-public-keys>

# Swagger UI at /docs (dev, qa only): a dlc-docs 07-api/contracts/openapi folder; empty disables it.
# With deploy/compose.docs.yml, DLC_DOCS_DIR below is mounted instead and the UI is at http://127.0.0.1:8090/docs
APPOINTMENTS_API_DOCS_DIR=
# APPOINTMENTS_DOCS_PORT=8090

# RabbitMQ of the compose "broker" profile, only for stages without a shared broker
RABBITMQ_DEFAULT_USER=<broker-user>
RABBITMQ_DEFAULT_PASS=<broker-password>

# Integration tests (empty: the database and broker tests are skipped)
TEST_DATABASE_URL=
TEST_DATABASE_USER=
TEST_DATABASE_PASSWORD=
TEST_RABBITMQ_URL=
# Path of a dlc-docs checkout: HTTP test responses are validated against its OpenAPI contracts,
# and deploy/compose.docs.yml serves them in Swagger UI
DLC_DOCS_DIR=
