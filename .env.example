# Application
SERVER_PORT=8080

# Staff access tokens (Norma 5.3.7) - public key only, never a private key
# Single-line PEM with literal \n, or a mounted file
JWT_PUBLIC_KEY=<single-line-public-key-pem>
# JWT_PUBLIC_KEY_FILE=/run/secrets/auth-public-key.pem
JWT_ISSUER=<auth-issuer>
JWT_AUDIENCE=<staff-token-audience>

# Auth session validation (private /internal/v1 route)
AUTH_INTERNAL_URL=<auth-internal-origin>
AUTH_SERVICE_TOKEN_FILE=/run/secrets/appointments-to-auth
# AUTH_SERVICE_TOKEN=

# PostgreSQL - local development only
POSTGRES_DB=appointments
POSTGRES_USER=appointments_user
POSTGRES_PASSWORD=appointments_local_password
POSTGRES_PORT=5432

# RabbitMQ - local development only
RABBITMQ_DEFAULT_USER=appointments_user
RABBITMQ_DEFAULT_PASS=rabbitmq_local_password
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Integration tests
# Leave empty when a real PostgreSQL test database is not available.
TEST_DATABASE_URL=
